{
  "mcpServers": {
    "deriv-smart-trading-gateway": {
      "command": "/absolute/path/to/deriv-smart-trading-gateway/.venv/bin/python",
      "args": [
        "/absolute/path/to/deriv-smart-trading-gateway/server.py"
      ],
      "env": {
        "DERIV_APP_ID": "1089",
        "DERIV_WS_URL_TEMPLATE": "wss://ws.derivws.com/websockets/v3?app_id={app_id}"
      }
    }
  }
}
